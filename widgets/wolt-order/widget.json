{
  "id": "wolt-order",
  "name": "Wolt Order",
  "description": "Shows when your Wolt delivery arrives, read from the Wolt order-tracking tab in Chrome or Safari.",
  "author": "joshuaKnauber",
  "version": "1.0.0",
  "icon": "icon.png",
  "show_when": { "order.active": true },
  "anytime": true,
  "watch": [
    { "script": "order.sh", "every": 30, "on": ["app"], "as": "order" }
  ],
  "initial": "tracking",
  "states": {
    "tracking": {
      "compact": {
        "leading": { "symbol": "bicycle", "tint": "#00C2E8" },
        "trailing": { "text": "{{order.eta | Wolt}}" }
      },
      "expanded": {
        "size": "compact",
        "header": { "symbol": "bicycle", "tint": "#00C2E8", "title": "{{order.venue | Wolt order}}" },
        "blocks": [
          { "text": "{{order.eta | No active order}}", "style": "title" },
          { "text": "{{order.status | Open your order's tracking page in Chrome or Safari}}", "style": "body" },
          { "note": "{{order.detail | }}" },
          { "row": [
            { "button": { "symbol": "arrow.up.right", "label": "Open tracking", "style": "plain", "do": [ { "open_url": "{{order.url | https://wolt.com}}" } ] } },
            "spacer",
            { "button": { "symbol": "arrow.clockwise", "label": "Refresh", "style": "plain", "do": [ { "refresh": "order" } ] } }
          ] }
        ]
      }
    }
  },
  "commands": {
    "show": {
      "description": "Show when the current Wolt order arrives.",
      "phrase": "Wolt order",
      "do": [ { "refresh": "order" }, { "go": "tracking" } ]
    },
    "refresh": {
      "description": "Re-read the Wolt tracking page now.",
      "phrase": "Refresh Wolt order",
      "do": [ { "refresh": "order" } ]
    },
    "open": {
      "description": "Open the Wolt order-tracking page.",
      "phrase": "Open Wolt tracking",
      "do": [ { "open_url": "{{order.url | https://wolt.com}}" } ]
    }
  },
  "preview": {
    "states": ["tracking"],
    "data": { "order": { "active": true, "venue": "Burger Bros", "status": "On the way", "eta": "12–17 min", "minutes": 12, "detail": "Arrives around 19:45", "url": "https://wolt.com" } }
  }
}
