{
  "id": "run-copied-command", "icon": "icon-mint-terminal.fill.png",
  "name": "Run Copied Command: T3 Code",
  "description": "When you copy a shell command in T3 Code, offers to run it in that thread's repo (or worktree) and shows its output in the notch.",
  "author": "joshuaKnauber",
  "version": "1.0.0",
  "show_when": {
    "app": "com.t3tools.t3code",
    "copied.is_cmd": true
  },
  "watch": [
    {
      "script": "clip.sh",
      "on": [
        "clipboard"
      ],
      "as": "copied"
    }
  ],
  "initial": "offer",
  "states": {
    "offer": {
      "open": true,
      "task": true,
      "compact": {
        "leading": {
          "symbol": "terminal.fill",
          "tint": "green"
        },
        "trailing": {
          "text": "{{copied.first | No command copied}}"
        }
      },
      "expanded": {
        "size": "regular",
        "header": {
          "symbol": "terminal.fill",
          "tint": "green",
          "title": "Run in {{copied.repo_name | home folder}}?"
        },
        "blocks": [
          {
            "code": "{{copied.cmd | Copy a shell command first}}"
          },
          {
            "row": [
              {
                "note": "{{copied.repo_short | ~}}"
              },
              "spacer",
              {
                "button": {
                  "symbol": "play.fill",
                  "label": "Run",
                  "style": "filled",
                  "tint": "green",
                  "do": [
                    {
                      "set": {
                        "cmd": "{{copied.cmd}}",
                        "repo": "{{copied.repo}}",
                        "repo_name": "{{copied.repo_name}}"
                      }
                    },
                    {
                      "go": "running"
                    }
                  ]
                }
              }
            ],
            "align": "center"
          }
        ]
      },
      "keys": [
        {
          "key": "cmd+return",
          "label": "Run",
          "do": [
            {
              "set": {
                "cmd": "{{copied.cmd}}",
                "repo": "{{copied.repo}}",
                "repo_name": "{{copied.repo_name}}"
              }
            },
            {
              "go": "running"
            }
          ]
        }
      ],
      "dismiss_after": 6
    },
    "running": {
      "task": true,
      "open": true,
      "stays_on_click_outside": true,
      "compact": {
        "leading": {
          "symbol": "terminal.fill",
          "tint": "green"
        },
        "trailing": "spinner"
      },
      "expanded": {
        "size": "wide",
        "header": {
          "symbol": "terminal.fill",
          "tint": "green",
          "title": "{{cmd}}"
        },
        "blocks": [
          {
            "code": "{{out | Starting…}}"
          },
          {
            "row": [
              {
                "chopsticks": {
                  "tint": "green"
                }
              },
              {
                "note": "Running in {{repo_name | the current T3 Code repo}}…"
              }
            ],
            "align": "center",
            "spacing": "tight"
          }
        ]
      },
      "on_enter": [
        {
          "set": {
            "out": ""
          }
        },
        {
          "run": "run.sh",
          "stream_to": "out",
          "then": "done",
          "else": "failed"
        }
      ]
    },
    "done": {
      "task": true,
      "compact": {
        "leading": {
          "symbol": "checkmark.circle.fill",
          "tint": "green"
        },
        "trailing": {
          "text": "Done"
        }
      },
      "expanded": {
        "size": "wide",
        "header": {
          "symbol": "checkmark.circle.fill",
          "tint": "green",
          "title": "{{cmd}}"
        },
        "blocks": [
          {
            "code": "{{out | (no output)}}"
          },
          {
            "row": [
              {
                "note": "{{repo_name}}"
              },
              {
                "button": {
                  "symbol": "doc.on.doc",
                  "label": "Copy output",
                  "style": "plain",
                  "do": [
                    {
                      "copy": "{{out}}"
                    }
                  ]
                }
              },
              {
                "button": {
                  "symbol": "arrow.clockwise",
                  "label": "Run again",
                  "do": [
                    {
                      "go": "running"
                    }
                  ]
                }
              }
            ],
            "align": "center"
          }
        ]
      }
    },
    "failed": {
      "task": true,
      "open": true,
      "compact": {
        "leading": {
          "symbol": "xmark.octagon.fill",
          "tint": "red"
        },
        "trailing": {
          "text": "Failed"
        }
      },
      "expanded": {
        "size": "wide",
        "header": {
          "symbol": "xmark.octagon.fill",
          "tint": "red",
          "title": "{{cmd}}"
        },
        "blocks": [
          {
            "code": "{{out}}{{error}}"
          },
          {
            "row": [
              {
                "note": "{{repo_name}}"
              },
              {
                "button": {
                  "symbol": "doc.on.doc",
                  "label": "Copy output",
                  "style": "plain",
                  "do": [
                    {
                      "copy": "{{out}}{{error}}"
                    }
                  ]
                }
              },
              {
                "button": {
                  "symbol": "arrow.clockwise",
                  "label": "Run again",
                  "do": [
                    {
                      "go": "running"
                    }
                  ]
                }
              }
            ],
            "align": "center"
          }
        ]
      }
    }
  },
  "commands": {
    "run_copied": {
      "description": "Run the shell command on the clipboard in the repo of the T3 Code thread it came from, and show its output.",
      "phrase": "Run copied command",
      "do": [
        {
          "set": {
            "cmd": "{{copied.cmd}}",
            "repo": "{{copied.repo}}",
            "repo_name": "{{copied.repo_name}}"
          }
        },
        {
          "go": "running"
        }
      ]
    },
    "run": {
      "description": "Run a shell command in a folder (defaults to the repo of the most recent T3 Code thread) and show its output.",
      "phrase": "Run {command}",
      "inputs": {
        "command": {
          "type": "string",
          "description": "The shell command to run"
        },
        "folder": {
          "type": "string",
          "description": "Absolute path of the folder to run it in",
          "optional": true
        }
      },
      "do": [
        {
          "set": {
            "cmd": "{{input.command}}",
            "repo": "{{input.folder}}",
            "repo_name": ""
          }
        },
        {
          "go": "running"
        }
      ]
    }
  },
  "preview": {
    "states": [
      "offer",
      "running",
      "done",
      "failed"
    ],
    "data": {
      "copied": {
        "is_cmd": true,
        "cmd": "npx wrangler deploy",
        "first": "npx wrangler deploy",
        "repo": "/Users/you/Projects/my-app",
        "repo_name": "my-app",
        "repo_short": "~/Projects/my-app"
      },
      "cmd": "npx wrangler deploy",
      "out": " ⛅️ wrangler 4.42.0\n───────────────────\nTotal Upload: 412.18 KiB / gzip: 88.03 KiB\nUploaded my-app (3.21 sec)\nDeployed my-app triggers (0.84 sec)\n  https://my-app.example.workers.dev\nCurrent Version ID: 7c1e4b2a-9f3d-4e61-b0a8-2d5f6c9e1a73",
      "error": "",
      "repo": "/Users/you/Projects/my-app",
      "repo_name": "my-app"
    }
  }
}
